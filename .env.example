APP_NAME="Telecom Agentic AI Support Platform"
APP_ENV=development
APP_DEBUG=false

API_V1_PREFIX=/api/v1

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

CORS_ORIGINS='["http://localhost:5173"]'

# Local development database only. Integration tests require TEST_DATABASE_URL
# explicitly targeting telecom_test_db; never point write tests at telecom_db.
DATABASE_URL=postgresql+psycopg:///telecom_db
TEST_DATABASE_URL=postgresql+psycopg:///telecom_test_db

# Qdrant local development defaults. QDRANT_API_KEY is optional for an
# unsecured local server and must be supplied only through the environment.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=telecom_knowledge
EMBEDDING_DIMENSIONS=384
RETRIEVAL_MIN_SCORE=0.03

# Required before knowledge administration or external MCP Gateway requests are
# enabled. Generate a strong secret outside Git and rotate it per environment.
# AUTH_JWT_SECRET=
AUTH_JWT_AUDIENCE=telecom-agentic-ai-support
# Microsoft Entra OIDC (identifiers are configuration; the secret stays in a
# secret file or deployment secret and must never use a VITE_ variable).
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_SECRET_FILE=secrets/entra_client_secret.txt
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_URL=http://localhost:5173
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false
# Optional. Leave unset to keep bounded investigations fail-closed/offline.
# DEEP_AGENT_MODEL=provider:model-name
# OPENAI_API_KEY is required only for an OpenAI model and must remain secret.
DEEP_AGENT_MAX_STEPS=8
DEEP_AGENT_MAX_TOOL_CALLS=6
DEEP_AGENT_TIMEOUT_SECONDS=20
